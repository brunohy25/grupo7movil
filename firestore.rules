rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo lee y edita su propio perfil
    match /usuarios/{idUsuario} {
      allow read, write: if request.auth != null && request.auth.uid == idUsuario;
    }

    // Cualquier usuario con sesión iniciada gestiona productos
    match /productos/{idProducto} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null && esProductoValido(request.resource.data);
    }

    function esProductoValido(p) {
      return p.nombre is string && p.nombre.size() > 0
          && p.stock is int && p.stock >= 0;
    }
  }
}
